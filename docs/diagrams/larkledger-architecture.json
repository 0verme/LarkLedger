  "cards": [
    {
      "dot": "violet",
      "title": "Reliable delivery",
      "items": [
        "PostgreSQL is the only queue · no Redis/Celery/Kafka; multi-instance safe via DB leases",
        "Transactional Outbox: business changes + reply intent commit atomically (T2)",
        "Lease-guarded status · succeeded / failed (exponential backoff) / dead; crash-window retry never re-runs business",
        "ReplyWorker redelivers pending/failed outbox rows after restart; Feishu uuid idempotency key",
        "Media (image/voice) downloaded via FeishuClient before AI parsing; keys persisted, binaries never",
        "Admin CLI replay-event (dry-run default) re-runs only safe dead/failed events (P06e)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Trust & safety",
      "items": [
        "Feishu events: webhook signature + decrypt + event_id dedup",
        "AI → ParsedCommand strict Pydantic validation · extra fields rejected · no SQL/table/DB identifiers",
        "LedgerService maps validated actions to fixed SQLAlchemy queries scoped to sender open_id",
        "Logs carry event_id/message_id only, never message bodies; DB backups = sensitive financial data"
      ]
    },
    {
      "dot": "amber",
      "title": "Supporting services",
      "items": [
        "ExchangeRateService: process-level FX cache → default currency; stale-cache fallback, fail-closed when empty",
        "ExportService: CSV Schema v1 · per-user · ≤5,000 rows / 90 days · read-only, no revisions",
        "ReportRenderer: report PNG + Feishu card; degrades to text card on failure",
        "ReadinessService: /readyz checks PostgreSQL, Alembic head, Event/Reply/Cleanup workers, receiver"
      ]
    },
    {
      "dot": "cyan",
      "title": "Persistence · PostgreSQL",
      "items": [
        "ledger_entries + append-only ledger_entry_revisions; (user_open_id, short_id) unique",
        "category_budgets · budget_alerts (80% / 100% threshold alerts)",
        "processed_events: versioned replayable payload + status/lease/backoff fields",
        "reply_outbox: self-contained reply intent + payload_blob (size / sha256) · event_replay_audits"
      ]
    }
  ]
