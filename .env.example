# Event delivery: webhook (default, public callback) or websocket (official SDK long connection)
LARK_LEDGER_EVENT_MODE=webhook

LARK_LEDGER_DATABASE_URL=postgresql+asyncpg://lark_ledger:change-me@db:5432/lark_ledger
LARK_LEDGER_TIMEZONE=Asia/Shanghai
LARK_LEDGER_CURRENCY=CNY

# Feishu Open Platform credentials. Never commit real values.
LARK_LEDGER_LARK_APP_ID=cli_xxxxxxxxxxxxx
LARK_LEDGER_LARK_APP_SECRET=replace-me
LARK_LEDGER_LARK_BASE_URL=https://open.feishu.cn

# Webhook mode only: callback verification and optional encrypted-event signature/decryption.
# Websocket mode does not require either value.
LARK_LEDGER_LARK_VERIFICATION_TOKEN=replace-me-for-webhook
LARK_LEDGER_LARK_ENCRYPT_KEY=

# OpenAI-compatible API (for example, DeepSeek).
LARK_LEDGER_AI_API_KEY=replace-me
LARK_LEDGER_AI_BASE_URL=https://api.openai.com/v1
LARK_LEDGER_AI_MODEL=gpt-4.1-mini
LARK_LEDGER_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
LARK_LEDGER_AI_TIMEOUT_SECONDS=45

# Optional local font file used to render Chinese consumption reports.
# Docker images include Noto CJK and normally do not need this setting.
LARK_LEDGER_REPORT_FONT_PATH=
