# =============================================================================
# LarkLedger environment example
# Copy to `.env` and replace every placeholder. Never commit real secrets.
# All runtime keys use the LARK_LEDGER_ prefix (see src/lark_ledger/config.py).
# =============================================================================

# -----------------------------------------------------------------------------
# Required — text-only quickstart (WebSocket + PostgreSQL + text AI)
# -----------------------------------------------------------------------------
# Runtime code default is webhook; set websocket here for the recommended path.
LARK_LEDGER_EVENT_MODE=websocket

# SQLAlchemy async URL (driver must be asyncpg).
# With compose.dev.yaml the app service URL is overridden to the bundled db.
# For external Postgres use a host the *container* can resolve (not container-local localhost).
LARK_LEDGER_DATABASE_URL=postgresql+asyncpg://lark_ledger:change-me@db:5432/lark_ledger

LARK_LEDGER_LARK_APP_ID=cli_xxxxxxxxxxxxx
LARK_LEDGER_LARK_APP_SECRET=replace-me
LARK_LEDGER_LARK_BASE_URL=https://open.feishu.cn

# Text understanding and report advice (OpenAI-compatible). Example: DeepSeek.
LARK_LEDGER_AI_API_KEY=replace-me
LARK_LEDGER_AI_BASE_URL=https://api.deepseek.com
LARK_LEDGER_AI_MODEL=deepseek-v4-flash

# -----------------------------------------------------------------------------
# Optional — safe defaults for most self-hosted deploys
# -----------------------------------------------------------------------------
LARK_LEDGER_TIMEZONE=Asia/Shanghai
LARK_LEDGER_CURRENCY=CNY
LARK_LEDGER_AI_TIMEOUT_SECONDS=45
LARK_LEDGER_EXCHANGE_RATE_API_URL=https://api.frankfurter.dev
LARK_LEDGER_EXCHANGE_RATE_CACHE_TTL_SECONDS=3600

# Optional local CJK font for report images. Docker images ship Noto CJK.
LARK_LEDGER_REPORT_FONT_PATH=

# -----------------------------------------------------------------------------
# Event worker (v0.2.1 reliable delivery) — safe defaults, usually unchanged.
# When enabled, entry points only claim events and the background worker
# processes them with lease, exponential-backoff retry, and dead-letter
# handling. Set WORKER_ENABLED=false to restore the legacy in-process sync path.
# -----------------------------------------------------------------------------
LARK_LEDGER_WORKER_ENABLED=true
# Seconds between worker sweeps; how many events one sweep may claim.
LARK_LEDGER_WORKER_POLL_INTERVAL_SECONDS=1.0
LARK_LEDGER_WORKER_BATCH_SIZE=10
# Maximum processing attempts (first attempt counts as 1) before an event is dead.
LARK_LEDGER_EVENT_MAX_ATTEMPTS=3
# Lease duration in seconds; a crashed worker's event is reclaimed after expiry.
LARK_LEDGER_EVENT_LEASE_SECONDS=300
# Exponential backoff base and cap for retries (base * 2^(attempt-1), capped).
LARK_LEDGER_EVENT_RETRY_BASE_SECONDS=2.0
LARK_LEDGER_EVENT_RETRY_MAX_SECONDS=3600

# -----------------------------------------------------------------------------
# Reply worker (v0.2.1 reliable delivery) — safe defaults, usually unchanged.
# When enabled, committed reply intents are delivered by a background worker
# with lease, exponential-backoff retry, and dead-letter handling. Set
# REPLY_WORKER_ENABLED=false to restore the compatible synchronous send path
# (it still uses the same lease-guarded outbox primitives).
# -----------------------------------------------------------------------------
LARK_LEDGER_REPLY_WORKER_ENABLED=true
# Seconds between sweeps; how many replies one sweep may claim.
LARK_LEDGER_REPLY_WORKER_POLL_INTERVAL_SECONDS=1.0
LARK_LEDGER_REPLY_WORKER_BATCH_SIZE=10
# Maximum delivery attempts (first attempt counts as 1) before a reply is dead.
LARK_LEDGER_REPLY_MAX_ATTEMPTS=3
# Lease duration in seconds; a crashed reply worker's row is reclaimed after expiry.
LARK_LEDGER_REPLY_LEASE_SECONDS=300
# Exponential backoff base and cap for reply retries (base * 2^(attempt-1), capped).
LARK_LEDGER_REPLY_RETRY_BASE_SECONDS=2.0
LARK_LEDGER_REPLY_RETRY_MAX_SECONDS=3600

# -----------------------------------------------------------------------------
# Terminal retention cleanup (v0.2.1 reliable delivery).
# Only terminal delivery records are eligible: succeeded/legacy_succeeded/dead
# events and sent/dead outbox rows. Ledger entries and revisions are never
# deleted. Use CLEANUP_ENABLED=false to disable; zero/negative retention is
# rejected so it can never mean "delete everything".
# -----------------------------------------------------------------------------
LARK_LEDGER_CLEANUP_ENABLED=true
LARK_LEDGER_CLEANUP_INTERVAL_SECONDS=3600
LARK_LEDGER_CLEANUP_BATCH_SIZE=500
LARK_LEDGER_EVENT_SUCCEEDED_RETENTION_DAYS=30
LARK_LEDGER_EVENT_DEAD_RETENTION_DAYS=90
LARK_LEDGER_OUTBOX_SENT_RETENTION_DAYS=30
LARK_LEDGER_OUTBOX_DEAD_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Optional — high-risk command confirmation (v0.3.0)
# risky_only: image / voice / batch / likely-duplicate writes wait for the
# user's 确认 #C-XXXXX; simple single text writes are unchanged. pending_enabled
# is the escape hatch that restores direct-write behavior for high-risk paths.
# -----------------------------------------------------------------------------
LARK_LEDGER_PENDING_ENABLED=true
LARK_LEDGER_PENDING_EXPIRES_SECONDS=86400
LARK_LEDGER_PENDING_RETENTION_DAYS=7
LARK_LEDGER_PENDING_DUPLICATE_WINDOW_MINUTES=60
LARK_LEDGER_PENDING_MAX_LIST=10

# -----------------------------------------------------------------------------
# Optional — recurring rules (v0.6.0 / P29)
# A background worker turns due active rules into confirmation pendings + Feishu
# reminders; rules never write ledger transactions directly. Disable only when
# the deployment does not want recurring-rule generation at all.
# -----------------------------------------------------------------------------
LARK_LEDGER_RECURRING_ENABLED=true
LARK_LEDGER_RECURRING_POLL_INTERVAL_SECONDS=300
LARK_LEDGER_RECURRING_BATCH_SIZE=10

# Optional Web Dashboard. Keep disabled until the Feishu OAuth redirect URL,
# HTTPS origin and a cryptographically random session secret are configured.
LARK_LEDGER_DASHBOARD_ENABLED=false
LARK_LEDGER_DASHBOARD_BASE_URL=https://ledger.example.com
LARK_LEDGER_DASHBOARD_SESSION_SECRET=
LARK_LEDGER_DASHBOARD_ADMIN_OPEN_IDS=
LARK_LEDGER_DASHBOARD_SESSION_TTL_SECONDS=28800
LARK_LEDGER_DASHBOARD_OAUTH_STATE_TTL_SECONDS=600
LARK_LEDGER_DASHBOARD_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Optional — image bookkeeping (not required for text-only)
# Leave empty to disable image features without blocking text entry.
# -----------------------------------------------------------------------------
LARK_LEDGER_VISION_API_KEY=
LARK_LEDGER_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LARK_LEDGER_VISION_MODEL=qwen3.7-plus

# -----------------------------------------------------------------------------
# Optional — speech / ASR bookkeeping (not required for text-only)
# -----------------------------------------------------------------------------
LARK_LEDGER_TRANSCRIPTION_API_KEY=
LARK_LEDGER_TRANSCRIPTION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LARK_LEDGER_TRANSCRIPTION_MODEL=qwen3-asr-flash
LARK_LEDGER_TRANSCRIPTION_LANGUAGE=zh
LARK_LEDGER_TRANSCRIPTION_ENABLE_ITN=true

# -----------------------------------------------------------------------------
# Webhook mode only (advanced alternative to WebSocket)
# Set LARK_LEDGER_EVENT_MODE=webhook and configure a public HTTPS callback:
#   https://your-domain/webhooks/feishu
# Long connection does not use these values.
# -----------------------------------------------------------------------------
LARK_LEDGER_LARK_VERIFICATION_TOKEN=
LARK_LEDGER_LARK_ENCRYPT_KEY=

# -----------------------------------------------------------------------------
# Optional — prebuilt image (compose.image.yaml)
# Pin a released version in production. Source builds via compose.yaml do not
# need this variable.
# -----------------------------------------------------------------------------
LARK_LEDGER_IMAGE_TAG=0.5.0

# Optional: alternate env file path for Compose (default .env).
# LARK_LEDGER_ENV_FILE=.env

# Optional: host port for compose.dev.yaml Postgres (bound to 127.0.0.1 only).
# LARK_LEDGER_DEV_POSTGRES_PORT=5432
